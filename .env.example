# --- Database ---
DATABASE_URL="postgresql://user:password@host:5432/vyro"

# --- Auth (next-auth) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email magic link — any SMTP provider (Resend, Postmark, SES...)
EMAIL_SERVER="smtp://user:pass@smtp.provider.com:587"
EMAIL_FROM="VYRO <noreply@yourdomain.com>"

# --- App ---
APP_URL="http://localhost:3000"

# --- AI: text/reasoning (required for MVP) ---
OPENROUTER_API_KEY=""

# --- AI: media generation (optional — mock providers used until set) ---
FAL_API_KEY=""
REPLICATE_API_TOKEN=""
ELEVENLABS_API_KEY=""
GROQ_API_KEY=""

# --- Storage (S3-compatible; Backblaze/Cloudflare R2 both have real free tiers) ---
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"
# Public, browser-fetchable base URL for the bucket — NOT the same as
# S3_ENDPOINT above for most providers (that one needs signed requests).
# Cloudflare R2: the bucket's "Public Development URL", e.g. https://pub-xxxx.r2.dev
# Backblaze B2: the "friendly URL", e.g. https://f000.backblazeb2.com/file/your-bucket-name
S3_PUBLIC_URL_BASE=""

# --- Testing safety switch ---
# Set to "true" to force every provider (image/video/TTS/STT) to its mock
# implementation regardless of whether the real API keys above are set —
# lets you test the full generation pipeline (queue, worker, timeline) for
# $0. Leave unset/"false" for a real deploy, or every click bills fal.ai /
# ElevenLabs for real. Does not affect text generation (OpenRouter) — LLM
# script costs are cents, not the runaway-bill risk video/TTS are.
VYRO_FORCE_MOCK_PROVIDERS="false"

# --- Background jobs (Redis, e.g. Render Key Value) ---
REDIS_URL="redis://localhost:6379"
